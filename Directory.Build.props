<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <RenderLabRoot>$(MSBuildThisFileDirectory)</RenderLabRoot>
    <BaseOutputPath>$(RenderLabRoot)out/dotnet/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RenderLabRoot)out/dotnet/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <NativeBuildDir Condition="'$(NativeBuildDir)' == ''">$(RenderLabRoot)out/build/windows-release</NativeBuildDir>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
