<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="WorkbenchBackground">#222222</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchSurface">#292929</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchRaised">#303030</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchInput">#202020</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchBorder">#3B3B3B</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchText">#E4E4E4</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchMuted">#AAAAAA</SolidColorBrush>
        <SolidColorBrush x:Key="WorkbenchAccent">#72C5B0</SolidColorBrush>
        <GridLength x:Key="SliderPreContentMargin">7</GridLength>
        <GridLength x:Key="SliderPostContentMargin">7</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>
        <ControlTheme x:Key="InspectorExpander" TargetType="Expander">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <ToggleButton x:Name="PART_toggle" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Height="32" MinHeight="32" Padding="12,0" BorderThickness="0" CornerRadius="0"
                                      Background="#2D2D2D">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked">#2D2D2D</SolidColorBrush>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver">#363636</SolidColorBrush>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver">#363636</SolidColorBrush>
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked">#E4E4E4</SolidColorBrush>
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver">#E4E4E4</SolidColorBrush>
                            </ToggleButton.Resources>
                            <Grid ColumnDefinitions="*,16">
                                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Text="&#xE70D;" FontSize="10" Foreground="#999999" VerticalAlignment="Center"
                                           RenderTransformOrigin="50%,50%">
                                    <TextBlock.RenderTransform><RotateTransform Angle="-90" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_ExpandSite" IsVisible="{TemplateBinding IsExpanded}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" Margin="0,6,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ ToggleButton:checked">
                <Setter Property="Background" Value="#2D2D2D" />
                <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}" />
            </Style>
            <Style Selector="^:expanded /template/ TextBlock#Chevron">
                <Setter Property="RenderTransform"><RotateTransform Angle="0" /></Setter>
            </Style>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchText}" />
    </Style>
    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurface}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="#C1C1C1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="#F09B8F" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Style>
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.metric">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.command, Button.primary">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="#383838" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
    </Style>
    <Style Selector="Button.tool">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#365B51" />
        <Setter Property="BorderBrush" Value="#528E7E" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ToggleButton:checked">
        <Setter Property="Background" Value="#365B51" />
        <Setter Property="Foreground" Value="#E1FFF5" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Expander.inspector">
        <Setter Property="Theme" Value="{StaticResource InspectorExpander}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.property">
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource WorkbenchRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{DynamicResource WorkbenchRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="360" />
    </Style>
</Styles>
