<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:RenderLab.Editor.ViewModels" xmlns:dock="using:Dock.Avalonia.Controls" xmlns:model="using:Dock.Model.Mvvm.Controls"
 x:Class="RenderLab.Editor.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="{Binding Title}"
 Width="1440" Height="900" MinWidth="1000" MinHeight="680">
 <Window.DataTemplates>
   <DataTemplate DataType="model:Document" x:DataType="model:Document"><ContentControl Content="{Binding Context}" /></DataTemplate>
 </Window.DataTemplates>
 <Grid RowDefinitions="Auto,*,Auto">
   <Menu>
     <MenuItem Header="Window">
       <MenuItem x:Name="SceneMenu" Header="Scene" Click="ShowPanel" Tag="Scene" />
       <MenuItem x:Name="SettingsMenu" Header="Render Settings" Click="ShowPanel" Tag="Settings" />
       <Separator />
       <MenuItem x:Name="GraphMenu" Header="Render Graph" Click="ShowPanel" Tag="Render Graph" />
       <MenuItem x:Name="ProfilerMenu" Header="Profiler" Click="ShowPanel" Tag="Profiler" />
       <MenuItem x:Name="LogMenu" Header="Log" Click="ShowPanel" Tag="Log" />
     </MenuItem>
     <MenuItem Header="Layout">
       <MenuItem Header="Default" Click="DefaultLayout" /><MenuItem Header="Diagnostics" Click="DiagnosticLayout" />
       <MenuItem Header="Restore saved layout" Click="RestoreLayout" />
     </MenuItem>
     <MenuItem Header="Scene"><MenuItem Header="Pause / Resume" Command="{Binding TogglePauseCommand}" /><MenuItem Header="Reset camera" Command="{Binding ResetCameraCommand}" /></MenuItem>
   </Menu>
   <dock:DockControl x:Name="Workbench" Grid.Row="1" />
   <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,4"><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
     <Button x:Name="LogStatus" Grid.Column="1" Content="Log" Click="OpenLog" Padding="8,2" />
   </Grid>
 </Grid>
</Window>
